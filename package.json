{
    "name": "babylonjs-editor-generated-template",
    "version": "4.1.0",
    "description": "Generated Template by BabylonJS Editor v4.1",
    "scripts": {
        "clean": "rimraf build declaration dist",
        "compile": "tsc -p .",
        "build": "webpack --mode production",
        "dev": "webpack serve --mode development",
        "watch": "npm run dev",
        "webserver": "http-server -p 1338 -c-1",
        "test": "node --no-deprecation node_modules/jest/bin/jest.js",
        "typecheck": "tsc --noEmit -p .",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "check:dist": "git diff --quiet -- dist && test -z \"$(git ls-files --others --exclude-standard -- dist)\" && echo 'dist/ is up to date' || (echo 'dist/ differs from the committed build: commit the new dist/' && exit 1)",
        "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:dist"
    },
    "license": "(Apache-2.0)",
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@babel/plugin-transform-modules-commonjs": "^7.24.8",
        "@babel/preset-env": "^7.25.3",
        "@babel/preset-typescript": "^7.24.7",
        "@babylonjs/core": "9.32.0",
        "@babylonjs/gui": "9.32.0",
        "@eslint/js": "^9.13.0",
        "@jest/globals": "^29.7.0",
        "@stylistic/eslint-plugin": "^2.9.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^18.7.4",
        "babel-jest": "^29.7.0",
        "babylonjs-editor-webpack-progress": "1.0.3",
        "eslint": "^9.13.0",
        "globals": "^15.11.0",
        "http-server": "^14.1.1",
        "jest": "^29.7.0",
        "jest-canvas-mock": "^2.5.2",
        "jest-environment-jsdom": "^29.7.0",
        "raw-loader": "4.0.2",
        "ts-loader": "^9.5.1",
        "typescript": "^5.5.4",
        "typescript-eslint": "^8.11.0",
        "webpack": "^5.93.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^4.15.2"
    },
    "dependencies": {
        "cannon": "^0.6.2",
        "earcut": "2.2.3",
        "rimraf": "3.0.2"
    }
}
